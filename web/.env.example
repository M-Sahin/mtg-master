# Required for real builds. Without it the app runs in demo mode.
ANTHROPIC_API_KEY=
# Optional: defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=
# Strongly recommended on a public URL: visitors need this code to start a build (it spends your API credits).
ACCESS_CODE=
# Optional: force demo mode even when a key is set (1 = on)
DEMO_MODE=
