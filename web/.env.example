# Copy to .env.local (Node.js / Docker) or add these in your host's settings (Vercel).
# Optional server key. Without it, visitors build with their own key (or watch the demo). Create one at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Required with a server key: visitors enter this code to build on it (protects your API credits).
ACCESS_CODE=
# Optional: defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=
# Optional: max builds per IP per hour (default 6)
BUILDS_PER_HOUR_PER_IP=
# Optional: 1 = allow builds without an access code (not recommended)
PUBLIC_ACCESS=
# Optional: 1 = force demo mode even when a key is set
DEMO_MODE=
# Optional: deckbuilding engine, v1 (default) or v2 (plan-first prompt, stricter checks, review pass,
# basics re-split, combo check). See README → Engine quality and evals.
ENGINE=
# Optional: short share links (/d/abc123) via Upstash Redis. On Vercel, connect "Upstash for Redis"
# from the Marketplace and these are set for you. Without them, links carry the whole deck (long).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: the public address used in share links (default on Vercel: the production domain)
SITE_URL=
# Optional: 0 = visitors can't use their own Claude API keys (default: they can)
OWN_KEYS=
# Optional: own-key builds per IP per hour (default 20)
OWN_KEY_BUILDS_PER_HOUR=
# Optional: donation link (https://ko-fi.com/…), shown in the footer and under finished decks
DONATION_URL=
