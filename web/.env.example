# Copy to .env.local (Node.js / Docker) or add these in your host's settings (Vercel).
# Required for real builds. Without it the app runs in demo mode. Create one at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Required as soon as ANTHROPIC_API_KEY is set: visitors enter this code to start a build (protects your API credits).
ACCESS_CODE=
# Optional: defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=
# Optional: max builds per IP per hour (default 6)
BUILDS_PER_HOUR_PER_IP=
# Optional: 1 = allow builds without an access code (not recommended)
PUBLIC_ACCESS=
# Optional: 1 = force demo mode even when a key is set
DEMO_MODE=
# Optional: deckbuilding engine, v1 (default) or v2 (plan-first prompt, stricter checks, review pass,
# basics re-split, combo check). See README → Engine quality and evals.
ENGINE=
